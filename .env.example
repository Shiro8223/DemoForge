# AI model: Gemini (migrating from Claude). Server-side only.
# Use flash for better storyboards, flash-lite if it's slow or rate-limited on the free tier.
GEMINI_API_KEY=AQ.Ab8RN6J6LVJ05Mio5gllIdKVgiuP9cHSEwQsw76NNVCfmctOlg
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Higgsfield MCP (server-side only). The token can also be set from /settings.
HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp
HIGGSFIELD_API_KEY=455c0520-afb9-4d98-878e-51628008db74:ca6a67fad18b07ca8a5115340d3bb828c4f011ae0cff25a30d1736b56234aca0
# Optional: pin tool names if auto-discovery picks the wrong ones
HIGGSFIELD_VIDEO_TOOL=
HIGGSFIELD_STATUS_TOOL=
# Max Higgsfield scenes per video (credits!)
HIGGSFIELD_MAX_SCENES=2

# Optional GitHub token (public repos do not need one; raises API rate limits). Never passed to repo code.
GITHUB_TOKEN=

# Sandbox: "local" or "docker"
DEMOFORGE_SANDBOX=local
DEMOFORGE_DOCKER_IMAGE=node:22-bookworm

# Paths (relative to the project root). Leave FFMPEG_PATH/FFPROBE_PATH as-is if ffmpeg is on PATH.
WORKSPACE_ROOT=workspaces
OUTPUT_ROOT=outputs
DATA_ROOT=data
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional royalty-free music track; otherwise a procedural ambient bed is synthesised.
MUSIC_PATH=
