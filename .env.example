# AI model: Gemini (migrating from Claude). Server-side only.
# Use flash for better storyboards, flash-lite if it's slow or rate-limited on the free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Higgsfield developer API (server-side only). console.higgsfield.ai -> API keys.
# Paste the key pair as KEY_ID:KEY_SECRET. Never commit real values.
HF_CREDENTIALS=
# Text-to-video model path. Kling 3.0 Standard (3-15 s) by default;
# Seedance 2.5 = bytedance/seedance-2.5/text-to-video (4-30 s).
HIGGSFIELD_MODEL=kling-video/v3.0/std/text-to-video
HIGGSFIELD_API_BASE=https://api.higgsfield.ai
# Max Higgsfield scenes per video (credits!)
HIGGSFIELD_MAX_SCENES=2

# Optional GitHub token (public repos do not need one; raises API rate limits). Never passed to repo code.
GITHUB_TOKEN=

# Sandbox: "local" or "docker"
DEMOFORGE_SANDBOX=local
DEMOFORGE_DOCKER_IMAGE=node:22-bookworm

# Paths (relative to the project root). Leave FFMPEG_PATH/FFPROBE_PATH as-is if ffmpeg is on PATH.
WORKSPACE_ROOT=workspaces
OUTPUT_ROOT=outputs
DATA_ROOT=data
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional royalty-free music track; otherwise a procedural ambient bed is synthesised.
MUSIC_PATH=
