# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Claude (server-side only). Without it, DemoForge falls back to deterministic
# analysis/storyboard templates and labels them as such in the UI.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
CLAUDE_MODEL=

# Higgsfield MCP (server-side only). The token can also be set from /settings.
HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp
HIGGSFIELD_API_KEY=
# Optional: pin tool names if auto-discovery picks the wrong ones
HIGGSFIELD_VIDEO_TOOL=
HIGGSFIELD_STATUS_TOOL=
# Max Higgsfield scenes per video (credits!)
HIGGSFIELD_MAX_SCENES=2

# Optional GitHub token (public repos do not need one). Never passed to repo code.
GITHUB_TOKEN=

# Worker
WORKSPACE_ROOT=./workspaces
OUTPUT_ROOT=./outputs
DATA_ROOT=./data
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# "local" (stripped env + timeouts) or "docker" (recommended for untrusted repos)
DEMOFORGE_SANDBOX=local
DEMOFORGE_DOCKER_IMAGE=node:22-bookworm
# Optional royalty-free music track; otherwise a procedural ambient bed is synthesised
MUSIC_PATH=
